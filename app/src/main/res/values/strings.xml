    <string name="airplane_title">Cycle airplane mode?</string>
    <string name="airplane_message">Every radio goes off for %1$d seconds and then back on. The device will be completely unreachable during that window — including adb over Wi-Fi. A failsafe alarm turns it back off even if this app is killed.</string>
    <string name="airplane_confirm">Cycle it</string>
    <string name="airplane_started">Airplane cycle started</string>
    <string name="airplane_unavailable">Needs WRITE_SECURE_SETTINGS — grant it over adb first</string>

