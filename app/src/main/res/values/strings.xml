    <string name="permission_title">Full recovery is disabled</string>
    <string name="permission_body">Grant WRITE_SECURE_SETTINGS over adb to allow a complete Wi-Fi driver reload. Without it the watchdog can only do a soft Wi-Fi toggle.</string>
