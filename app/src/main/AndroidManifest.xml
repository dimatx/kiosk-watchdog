<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        Lets the app ask to be exempted from Doze. Without the exemption Android
        throttles setExactAndAllowWhileIdle to roughly one firing every 9-15
        minutes while idle, which stretches both the check interval and the
        heartbeat by the same amount.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Needed so SSID/BSSID/RSSI are not redacted on API 27+. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Only used by the auto-confirm self-test, which hands the app's own APK
        back to the package installer so the update dialog can be exercised on
        demand instead of waiting for another app to ship an update. Normal
        permission, granted at install time.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Not grantable from the UI. Grant once over adb:
          adb shell pm grant com.shymoose.wifiwatchdog android.permission.WRITE_SECURE_SETTINGS
        Without it the hard-reset rung (full driver unload) is unavailable; every
        other rung still works.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WifiWatchdog">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".WatchdogService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TickReceiver"
            android:exported="false" />

        <!-- Failsafe: guarantees airplane mode is turned back off even if the
             service dies mid-cycle. -->
        <receiver
            android:name=".AirplaneRestoreReceiver"
            android:exported="false" />

        <!--
            Airplane mode cannot be toggled by a normal app: the setting is
            writable with WRITE_SECURE_SETTINGS but the radios only follow the
            protected ACTION_AIRPLANE_MODE_CHANGED broadcast, which requires
            CONNECTIVITY_INTERNAL (signature|privileged, not grantable).

            Settings ships AirplaneModeVoiceActivity for exactly this, but it
            rejects anything that is not the voice-interaction root. So the app
            registers itself as a VoiceInteractionService and issues the request
            through a session — the same route MacroDroid uses.
        -->
        <service
            android:name=".AssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".AssistantSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Declaring a recognition service is mandatory for a voice interactor,
             even though this one does nothing. -->
        <service
            android:name=".StubRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!--
            Confirms the package installer's update dialog. Android 8.1 has no
            rootless silent install, so an app that ships its own updates
            otherwise waits forever for someone to tap INSTALL on the wall.
        -->
        <service
            android:name=".InstallAutoClickService"
            android:exported="true"
            android:label="@string/a11y_install_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/install_click_service" />
        </service>

        <!--
            Hands the app's own APK to the package installer for the auto-confirm
            self-test. A file:// URI would trip FileUriExposedException, so the
            copy is served from the cache dir through a content:// URI instead.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
