    <!-- Settings screen -->
    <string name="cat_probe">Connectivity check</string>
    <string name="pref_probe_host">Probe host</string>
    <string name="pref_probe_host_summary">Leave blank to follow the Wi-Fi gateway automatically.</string>
    <string name="pref_probe_port">Probe port</string>
    <string name="pref_probe_port_summary">Only used when a probe host is set; gateway checks use ICMP.</string>
    <string name="pref_interval">Check interval (seconds)</string>

    <string name="cat_escalation">Recovery ladder</string>
    <string name="pref_t_reassociate">Re-associate after (seconds down)</string>
    <string name="pref_t_soft">Wi-Fi off/on after (seconds down)</string>
    <string name="pref_t_hard">Full driver reload after (seconds down)</string>
    <string name="pref_hard_enabled">Allow full driver reload</string>
    <string name="pref_hard_enabled_summary">Uses WRITE_SECURE_SETTINGS to unload and reload the Wi-Fi driver — the airplane-mode equivalent.</string>

    <string name="cat_airplane">Airplane-mode cycle</string>
    <string name="pref_airplane_enabled">Allow airplane-mode cycle</string>
    <string name="pref_airplane_enabled_summary">Last resort. Turns every radio off and on through the assistant channel — the only rootless way to trigger a real airplane-mode toggle.</string>
    <string name="pref_t_airplane">Airplane cycle after (seconds down)</string>
    <string name="pref_t_airplane_summary">How long the link must stay down before the heaviest rung runs.</string>
    <string name="pref_airplane_dwell">Airplane dwell (seconds)</string>
    <string name="pref_airplane_dwell_summary">How long to stay in airplane mode before switching back.</string>

    <string name="cat_reporting">Notifications (ntfy)</string>
    <string name="pref_ntfy_url">Server URL</string>
    <string name="pref_ntfy_url_summary">Base URL of the ntfy server. Defaults to https://ntfy.sh.</string>
    <string name="pref_ntfy_topic">Topic</string>
    <string name="pref_ntfy_topic_summary">Required. Leave blank to disable notifications entirely.</string>
    <string name="pref_ntfy_user">Username</string>
    <string name="pref_ntfy_user_summary">Optional. Leave blank for an open topic, or when using an access token.</string>
    <string name="pref_ntfy_password">Password or access token</string>
    <string name="pref_ntfy_password_summary">Optional. Sent as basic auth with a username, or as a bearer token without one.</string>
    <string name="pref_ntfy_test">Send test notification</string>
    <string name="pref_ntfy_test_summary">Publishes a message straight away and records the result in the event log.</string>

